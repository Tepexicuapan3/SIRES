#frontend/Dockerfile.local
FROM node:22

## Nota
# Vite 7 + React plugin (SWC) corre ok con Node >= 20.19 / >= 22.12.
# Imagen Debian (no alpine): Playwright --with-deps instala sus libs de sistema
# via apt y sus browsers no corren de forma confiable sobre musl (alpine).

RUN corepack enable && corepack prepare pnpm@11.13.1 --activate

WORKDIR /app

COPY package.json ./
COPY pnpm-lock.yaml ./

EXPOSE 5173

# Deps se instalan al arrancar (docker-compose command) para que queden en el volumen /app/node_modules.
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]