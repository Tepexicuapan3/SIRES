# ============================================
# SISEM - Plantilla de produccion (IP/dominio publico)
#
# NO copies .env.example (esa es la de desarrollo local: DEBUG=true,
# ALLOW_ALL_HOSTS=true, SECRET_KEY de ejemplo). Copia ESTE archivo a
# ".env" en el servidor de produccion y completa cada valor marcado
# con <...>.
# ============================================

COMPOSE_PROJECT_NAME=sisem

# --- Base de datos dominio Auth (PostgreSQL) ---
AUTH_DB_NAME=sisem_auth
AUTH_DB_USER=sisem_auth
AUTH_DB_PASSWORD=<password-fuerte-y-unico>

# --- Backend (Django) ---
DEBUG=false
# Genera uno nuevo, no reutilices el de .env.example ni el que traia
# settings.py como default:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<clave-generada-de-50-caracteres>
ALLOW_ALL_HOSTS=false
DJANGO_ALLOWED_HOSTS=<tu-ip-o-dominio-real>
DJANGO_CORS_ALLOWED_ORIGINS=https://<tu-dominio-real>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<tu-dominio-real>
WS_ALLOW_ALL_ORIGINS=false
WS_ALLOWED_ORIGINS=
RUN_SEED_ON_BOOT=false
RUN_E2E_SEED_ON_BOOT=false
ALLOW_USER_CREATE_WITHOUT_EMAIL=false
RBAC_READ_S1_ENABLED=false
RBAC_ROLE_MUTATION_S2_ENABLED=false
RBAC_ROLE_PERMISSION_S3_ENABLED=false

# Activar SOLO cuando ya haya dominio + certificado TLS reales
# (ver nginx/proxy.conf -- hoy sirve por HTTP plano porque Let's Encrypt
# no emite certificados para IPs sueltas). Con TLS activo, poner los 3 en
# true; mientras tanto dejarlos en false o el sitio queda inaccesible.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0

# --- Oracle (SERMED) ---
# Rota esta contrasena en Oracle antes de usarla aqui si el proyecto alguna
# vez uso el config.json + cont.py que traia la clave AES hardcodeada en el
# propio repo (ese secreto se debe considerar comprometido).
ORACLE_USER=<usuario-oracle>
ORACLE_PASSWORD=<password-oracle-rotado>
ORACLE_HOST=<host-oracle>
ORACLE_PORT=1526
ORACLE_SERVICE=<service-name-oracle>

# --- Expedientes (Postgres remoto/local segun infraestructura real) ---
EXPEDIENTES_HOST=<host-expedientes>
EXPEDIENTES_PORT=5432
EXPEDIENTES_NAME=<db-expedientes>
EXPEDIENTES_USER=<usuario-expedientes>
EXPEDIENTES_PASSWORD=<password-expedientes>

# --- SMTP / Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp-real>
EMAIL_PORT=587
EMAIL_HOST_USER=<usuario-smtp>
EMAIL_HOST_PASSWORD=<password-smtp>
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@<tu-dominio-real>
EMAIL_TIMEOUT=10

# Branding SISEM.
SISEM_LOGIN_URL=https://<tu-dominio-real>/login
SISEM_SUPPORT_EMAIL=soporte@<tu-dominio-real>

# --- Frontend (Vite, build-time) ---
VITE_API_URL=https://<tu-dominio-real>/api/v1
VITE_APP_NAME=SISEM
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=30000
VITE_USE_MSW=false
